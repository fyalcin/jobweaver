# Copy to .env and fill in what you use. .env is never committed.

# Language models: at least one of the two routes below.
# 1. OpenRouter (https://openrouter.ai): many hosted models with one key.
OPENROUTER_API_KEY=

# 2. Any OpenAI-compatible endpoint: a local server (Ollama, LM Studio, vLLM, llama.cpp) or a hosted API.
#    Include the /v1 part. Its models appear in Settings as custom/<model>.
#    Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
CUSTOM_MODEL_BASE_URL=
#    Only if the endpoint needs a key (local servers usually do not).
CUSTOM_MODEL_API_KEY=

# Optional: Apify token for the LinkedIn and karriere.at actors. You run them under Apify's and the site's terms.
APIFY_API_TOKEN=

# Optional remote deployment: configure a trusted HTTPS reverse proxy first.
# Browser requests must use the same origin as the frontend. No wildcard hosts.
# JOBWEAVER_ALLOWED_HOSTS=jobs.example.com
# JOBWEAVER_HTTPS_ONLY=1

# Optional per-User daily model quota (requests and requested output tokens, not money).
# Per-User overrides: python -m jobweaver.manage_users quota USERNAME. Day boundary: JOBWEAVER_QUOTA_TZ, default local time.
# JOBWEAVER_QUOTA_REQUESTS=300
# JOBWEAVER_QUOTA_OUTPUT_TOKENS=2400000
# JOBWEAVER_QUOTA_TZ=Europe/Vienna
